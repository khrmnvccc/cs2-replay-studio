# ─── CS2 Match Replay Studio — background worker ────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Qaysi ishlarni bajaradi: parse, sync, gc, zip, render (vergul bilan)
#  Linux/Docker server:  parse,sync,zip   (+ gc, agar bot akkaunt bo'lsa)
#  Windows render PC:    render
WORKER_CAPABILITIES=parse,sync,zip
WORKER_CONCURRENCY=2
# WORKER_ID=vps-1
# WORK_DIR=/var/lib/cs2-replay-worker

# sync (match tarixi) uchun — web ilovadagi bilan bir xil
STEAM_API_KEY=
APP_ENCRYPTION_KEY=

# gc — Valve Game Coordinator (match sanasi, hisob, demo URL).
# ALOHIDA Steam akkaunt ishlating (asosiy akkauntingizni emas). Unda CS2 bo'lishi kerak.
# Tavsiya: refresh token (bir marta login qilib olinadi, README'ga qarang)
STEAM_BOT_REFRESH_TOKEN=
# yoki:
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=

# render — faqat Windows + CS2 + HLAE
# RENDER_BACKEND=csdm
# CSDM_PATH=C:\Program Files\CS Demo Manager\csdm.exe
# RENDER_BACKEND=command
# RENDER_COMMAND="C:\tools\my-render.bat" {demo} {start} {end} {steamid} {out} {width} {height} {fps}
RENDER_TIMEOUT_MINUTES=20
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
