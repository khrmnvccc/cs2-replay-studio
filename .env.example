# ─── CS2 Match Replay Studio — web ilova (Next.js) ───────────────────────────
# Nusxa oling:  cp .env.example .env.local   (.env.local GitHub'ga YUKLANMAYDI)

# Saytning to'liq manzili (Steam OpenID return_to va realm uchun). Oxirida "/" yo'q.
APP_URL=http://localhost:3000

# https://steamcommunity.com/dev/apikey  — faqat serverda ishlatiladi
STEAM_API_KEY=

# Session cookie imzosi:  openssl rand -base64 48
SESSION_SECRET=

# Steam Game Authentication Code'ni shifrlash (AES-256-GCM):  openssl rand -base64 32
# Worker'da ham AYNAN SHU qiymat bo'lishi kerak.
APP_ENCRYPTION_KEY=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Faqat server! Hech qachon NEXT_PUBLIC_ prefiksi bilan bermang.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → JWT Keys → "Legacy JWT secret" (HS256).
# Server shu bilan foydalanuvchi JWT'sini imzolaydi va RLS auth.uid() orqali ishlaydi.
SUPABASE_JWT_SECRET=

# Demo fayl maksimal hajmi (MB). Supabase Free plan global limiti 50 MB!
DEMO_MAX_MB=1024
